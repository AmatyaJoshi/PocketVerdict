# MySQL (docker compose up -d starts one on port 3307)
DATABASE_URL="mysql://buyorwait:buyorwait@localhost:3307/buyorwait"

# NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-please-32-bytes-minimum-secret"
AUTH_URL="http://localhost:3000"

# Demo login created by `npm run db:seed`
ADMIN_EMAIL="demo@buyorwait.app"
ADMIN_PASSWORD="demo1234"

# Decision engine (repository root that contains code/ and dataset/) and Python binary
ENGINE_ROOT="../"
PYTHON_BIN="python"

# Optional model providers used by the engine for images / unusual messages
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
BUYORWAIT_LLM="auto"

# Advisor chatbot: uses Claude when ANTHROPIC_API_KEY is set, otherwise grounded template answers
# ADVISOR_MODEL="claude-opus-5"
